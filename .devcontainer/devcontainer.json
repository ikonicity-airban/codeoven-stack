{
  "name": "monorepo",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "postCreateCommand": "corepack enable && pnpm install",
  "forwardPorts": [3000, 8787],
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
