# Copy to .env and fill in. Lines tagged "@module:<name>" are removed by `pnpm setup` if that module is deselected.

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8787
# Pooled URL on Vercel/serverless (Supabase transaction pooler, port 6543); direct URL on a VPS.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Set to "true" when DATABASE_URL points at a transaction pooler (disables prepared statements).
DATABASE_POOLED=false

# --- Supabase / Auth ---  # @module:auth
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 # @module:auth
NEXT_PUBLIC_SUPABASE_ANON_KEY= # @module:auth
SUPABASE_SERVICE_ROLE_KEY= # @module:auth

# --- Email (Resend) --- # @module:email
RESEND_API_KEY= # @module:email
EMAIL_FROM="App <onboarding@resend.dev>" # @module:email

# --- Payments --- # @module:payments
PAYMENT_PROVIDER=paystack # @module:payments
PAYSTACK_SECRET_KEY= # @module:payments

# --- Notifications (Termii SMS) --- # @module:notifications
TERMII_API_KEY= # @module:notifications
TERMII_SENDER_ID= # @module:notifications

# --- Jobs (Inngest) --- # @module:jobs
INNGEST_EVENT_KEY= # @module:jobs
INNGEST_SIGNING_KEY= # @module:jobs

# --- Observability --- # @module:observability
SENTRY_DSN= # @module:observability
NEXT_PUBLIC_POSTHOG_KEY= # @module:observability
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com # @module:observability
LOG_LEVEL=info # @module:observability
